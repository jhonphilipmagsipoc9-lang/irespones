</com.google.android.material.textfield.TextInputLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:orientation="horizontal"><com.google.android.material.button.MaterialButton android:id="@+id/btn_pick_map" style="@style/Widget.RescueLink.Button.Outline" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:layout_weight="1" android:minHeight="44dp" android:text="Pick on map" android:textSize="14sp" /><com.google.android.material.button.MaterialButton android:id="@+id/btn_use_my_loc" style="@style/Widget.RescueLink.Button.Outline" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_weight="1" android:minHeight="44dp" android:text="Use my location" android:textSize="14sp" /></LinearLayout><TextView android:id="@+id/tv_pin_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:textColor="?attr/rlAccent" android:textSize="13sp" /><com.google.android.material.textfield.TextInputLayout android:id="@+id/til_landmark" style="@style/Widget.RescueLink.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:hint="Landmark (optional)">
