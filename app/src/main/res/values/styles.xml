<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ================= Theme (Material 3) ================= -->
    <style name="Theme.RescueLink" parent="Theme.Material3.Light.NoActionBar">
        <!-- default theme colour (Navy); Settings > Appearance applies an overlay on top -->
        <item name="rlPrimary">@color/navy</item>
        <item name="rlAccent">@color/secondary_blue</item>
        <item name="rlPrimaryContainer">@color/primary_container</item>
        <item name="rlSecondaryContainer">@color/secondary_container</item>
        <item name="rlPale">@color/pale_blue</item>
        <item name="rlHeroStart">@color/hero_start</item>
        <item name="rlHeroEnd">@color/hero_end</item>
        <item name="colorPrimary">?attr/rlPrimary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">?attr/rlPrimaryContainer</item>
        <item name="colorOnPrimaryContainer">?attr/rlPrimary</item>
        <item name="colorSecondary">?attr/rlAccent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">?attr/rlSecondaryContainer</item>
        <item name="colorOnSecondaryContainer">?attr/rlPrimary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_main</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/border</item>
        <item name="colorError">@color/critical</item>
        <item name="colorOnError">@color/white</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/text_main</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowAnimationStyle">@style/Animation.RescueLink.Window</item>
        <item name="materialCardViewStyle">@style/Widget.RescueLink.Card</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.RescueLink.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.RescueLink.Medium</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.RescueLink.BottomSheet</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.RescueLink.Dialog</item>
    </style>

    <!-- Screen transitions: forward slides in from the right, back reverses -->
    <style name="Animation.RescueLink.Window" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/screen_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/screen_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/screen_pop_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/screen_pop_exit</item>
    </style>

    <style name="ThemeOverlay.RescueLink.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowAnimationStyle">@style/Animation.RescueLink.Dialog</item>
    </style>

    <style name="ThemeOverlay.RescueLink.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.RescueLink.BottomSheet</item>
    </style>

    <style name="Widget.RescueLink.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@color/surface</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.RescueLink.Sheet</item>
    </style>

    <style name="Animation.RescueLink.Dialog" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/dialog_in</item>
        <item name="android:windowExitAnimation">@anim/dialog_out</item>
    </style>

    <!-- ================= Shapes ================= -->
    <style name="ShapeAppearance.RescueLink.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_input</item>
    </style>
    <style name="ShapeAppearance.RescueLink.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_card</item>
    </style>
    <style name="ShapeAppearance.RescueLink.Sheet" parent="">
        <item name="cornerFamilyTopLeft">rounded</item>
        <item name="cornerFamilyTopRight">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- ================= Typography ================= -->
    <style name="TextAppearance.RL.Display" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_main</item>
    </style>
    <style name="TextAppearance.RL.Title" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/text_main</item>
    </style>
    <style name="TextAppearance.RL.Heading" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/text_main</item>
    </style>
    <style name="TextAppearance.RL.Body" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_main</item>
    </style>
    <style name="TextAppearance.RL.Label" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="TextAppearance.RL.Caption" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- ================= Cards ================= -->
    <style name="Widget.RescueLink.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">?attr/rlPrimaryContainer</item>
    </style>

    <!-- ================= Buttons ================= -->
    <style name="Widget.RescueLink.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">?attr/rlPrimary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="rippleColor">#33FFFFFF</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.RescueLink.Button.Emergency" parent="Widget.RescueLink.Button">
        <item name="backgroundTint">@color/critical</item>
    </style>

    <style name="Widget.RescueLink.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">?attr/rlPrimaryContainer</item>
        <item name="android:textColor">?attr/rlPrimary</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.RescueLink.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">?attr/rlPrimary</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">?attr/rlPrimary</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.RescueLink.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">?attr/rlAccent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.RescueLink.Button.Danger" parent="Widget.RescueLink.Button.Text">
        <item name="android:textColor">@color/critical</item>
    </style>

    <!-- ================= Inputs ================= -->
    <style name="Widget.RescueLink.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_input</item>
        <item name="boxStrokeColor">@color/box_stroke</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="hintTextColor">?attr/rlAccent</item>
        <item name="errorTextColor">@color/critical</item>
        <item name="boxStrokeErrorColor">@color/critical</item>
        <item name="errorIconTint">@color/critical</item>
    </style>

    <style name="Widget.RescueLink.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_input</item>
        <item name="boxStrokeColor">@color/box_stroke</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="hintTextColor">?attr/rlAccent</item>
        <item name="errorTextColor">@color/critical</item>
        <item name="boxStrokeErrorColor">@color/critical</item>
    </style>

    <!-- ================= Badges and search ================= -->
    <style name="Widget.RescueLink.Badge" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="Widget.RescueLink.Search" parent="">
        <item name="android:background">@drawable/bg_search</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textColorHint">@color/text_secondary</item>
    </style>

    <!-- Invisible screen used only to hand a widget tap over to the call/SMS code -->
    <style name="Theme.RescueLink.Transparent" parent="Theme.Material3.Light.NoActionBar">
        <!-- default theme colour (Navy); Settings > Appearance applies an overlay on top -->
        <item name="rlPrimary">@color/navy</item>
        <item name="rlAccent">@color/secondary_blue</item>
        <item name="rlPrimaryContainer">@color/primary_container</item>
        <item name="rlSecondaryContainer">@color/secondary_container</item>
        <item name="rlPale">@color/pale_blue</item>
        <item name="rlHeroStart">@color/hero_start</item>
        <item name="rlHeroEnd">@color/hero_end</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
